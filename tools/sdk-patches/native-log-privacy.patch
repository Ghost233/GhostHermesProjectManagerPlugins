+def _native_log_launchd_environment() -> dict[str, str]:
+    """Carry only native log privacy bootstrap values across plist refreshes."""
+    keys = ("HERMES_NATIVE_LOG_POLICY", "HERMES_NATIVE_GATEWAY_HOST")
+    environment = {key: os.environ[key] for key in keys if os.environ.get(key)}
+    path = _gw().get_launchd_plist_path()
+    if path.exists():
+        try:
+            raw = path.read_bytes()
+            try:
+                definition = plistlib.loads(raw)
+                if not isinstance(definition, dict):
+                    raise ValueError
+            except Exception:
+                # Decode XML entities before deciding an invalid definition is unprotected legacy.
+                from html import unescape
+                text = raw.decode("utf-16" if raw.startswith((b"\xff\xfe", b"\xfe\xff")) else "utf-8-sig")
+                if "\x00" in text:
+                    raise ValueError
+                if not any(key in unescape(text) for key in keys):
+                    return environment
+                raise
+            installed = definition.get("EnvironmentVariables", {})
+            if not isinstance(installed, dict):
+                raise ValueError
+            for key in keys:
+                if key in installed:
+                    value = installed[key]
+                    if not isinstance(value, str) or not value:
+                        raise ValueError
+                    environment[key] = value
+        except Exception:
+            raise SystemExit("Native log privacy service definition unavailable; refresh refused.") from None
+    return environment
+
