@@ -0,0 +1,204 @@
+"""Opt-in local log privacy for the configured Mac gateway host.
+
+This affects diagnostics only; it does not register token redaction for agent
+messages or tool results. Policies are loaded once, before native startup.
+"""
+from __future__ import annotations
+
+import faulthandler
+import json
+import logging
+import os
+from pathlib import Path
+import stat
+import signal
+import sys
+
+_POLICY_ENV = 'HERMES_NATIVE_LOG_POLICY'
+_STATUS = '[protected native log]'
+_homes: frozenset[str] = frozenset()
+_values: tuple[str, ...] = ()
+_loaded = False
+_gateway_stdio_closed = False
+_gateway_host = False
+_privacy_factory = None
+_signal_handler = None
+
+
+def _home_key(home) -> str:
+    return str(Path(home).expanduser().resolve())
+
+
+def protected_profile_logging_active(home) -> bool:
+    """True only for an exact home under effective gateway log protection.
+
+    The owned adapter must reject startup when a gateway was embedded without
+    its early host marker, or when another component replaced our factory/fds.
+    """
+    if not (_loaded and _gateway_host and _gateway_stdio_closed):
+        return False
+    try:
+        if _home_key(home) not in _homes:
+            return False
+        factory = logging.getLogRecordFactory()
+        for _ in range(8):
+            if factory is _privacy_factory:
+                break
+            factory = getattr(factory, '_hermes_native_privacy_parent', None)
+        else:
+            return False
+        if _signal_handler is None or signal.getsignal(signal.SIGUSR2) is not _signal_handler:
+            return False
+        null = os.stat(os.devnull)
+        return all((os.fstat(fd).st_dev, os.fstat(fd).st_ino) == (null.st_dev, null.st_ino) for fd in (1, 2))
+    except Exception:
+        return False
+
+
+def protected_native_diagnostic_scope_active() -> bool:
+    """Whether this diagnostic may contain protected work or lost gateway scope."""
+    if not _loaded:
+        return False
+    constants = sys.modules.get('hermes_constants')
+    resolver = getattr(constants, 'get_hermes_home', None)
+    override = getattr(constants, 'get_hermes_home_override', lambda: None)()
+    try:
+        home = _home_key(resolver() if resolver else os.environ.get('HERMES_HOME', '~/.hermes'))
+        return home in _homes or (_gateway_host and not override)
+    except Exception:
+        return True
+
+
+def protected_gateway_diagnostics_active() -> bool:
+    """Whether configured protection requires host-wide diagnostic suppression."""
+    return _loaded and bool(_homes)
+
+
+def _record_home(record) -> str:
+    constants = sys.modules.get('hermes_constants')
+    resolver = getattr(constants, 'get_hermes_home', None)
+    try:
+        return _home_key(resolver() if resolver else os.environ.get('HERMES_HOME', '~/.hermes'))
+    except Exception:
+        return ''
+
+
+def protect_log_record(record):
+    """Sanitize native records before any inherited or independent handler sees them."""
+    if not _loaded:
+        return record
+    home = _record_home(record)
+    try:
+        message = record.getMessage()
+        bound = any(value in message or value in record.name for value in _values)
+    except Exception:
+        bound = True
+    # Unscoped exceptions and Feishu SDK records may contain protected messages
+    # from callback/connection threads that lost their profile ContextVar.
+    constants = sys.modules.get('hermes_constants')
+    override = getattr(constants, 'get_hermes_home_override', lambda: None)()
+    unsafe = (_gateway_host and not override) or home in _homes or bound or bool(record.exc_info or record.stack_info)
+    unsafe = unsafe or record.name.startswith(('lark', 'Lark', 'plugins.platforms.feishu', 'gateway.platforms.feishu'))
+    if unsafe:
+        record.msg, record.args = _STATUS, ()
+        record.exc_info = record.exc_text = record.stack_info = None
+        record.session_tag = ''
+        record.name = 'gateway.native'
+        record.pathname = record.filename = record.module = record.funcName = ''
+        record.lineno = 0
+    return record
+
+
+def _load_policy():
+    global _homes, _values, _loaded
+    reference = os.environ.get(_POLICY_ENV)
+    if not reference:
+        return
+    try:
+        path = Path(reference)
+        if not path.is_absolute() or any(part in ('.', '..') for part in path.parts):
+            raise ValueError
+        directory = os.open(path.anchor, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            for part in path.parts[1:-1]:
+                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
+                os.close(directory)
+                directory = child
+            parent = os.fstat(directory)
+            if parent.st_uid != os.getuid() or stat.S_IMODE(parent.st_mode) != 0o700:
+                raise ValueError
+            fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+            with os.fdopen(fd, 'r', encoding='utf-8') as stream:
+                item = os.fstat(stream.fileno())
+                if not stat.S_ISREG(item.st_mode) or item.st_uid != os.getuid() or stat.S_IMODE(item.st_mode) != 0o600 or item.st_nlink != 1:
+                    raise ValueError
+                policy = json.load(stream)
+        finally:
+            os.close(directory)
+        homes, values = policy['protected_homes'], policy['protected_values']
+        if policy.get('version') != 1 or not isinstance(homes, list) or not homes or not isinstance(values, list):
+            raise ValueError
+        if any(not isinstance(home, str) or not Path(home).is_absolute() for home in homes):
+            raise ValueError
+        if any(not isinstance(value, str) or not value for value in values):
+            raise ValueError
+        _homes = frozenset(_home_key(home) for home in homes)
+        _values = tuple(dict.fromkeys((*homes, *values)))
+        _loaded = True
+    except Exception:
+        raise SystemExit('Native log privacy policy unavailable; startup refused.') from None
+
+
+def suppress_gateway_stdio() -> None:
+    """Suppress raw service diagnostics, including C/SDK fd writes.
+
+    Gateway stdout/stderr are service logs, not CLI/ACP response transports.
+    File logs for ordinary profiles still use their existing handlers.
+    """
+    global _gateway_stdio_closed, _gateway_host, _signal_handler
+    if not protected_gateway_diagnostics_active() or _gateway_stdio_closed:
+        return
+    _gateway_host = True
+    try:
+        os.write(2, b'[protected native log] service console diagnostics suppressed\n')
+        fd = os.open(os.devnull, os.O_WRONLY)
+        try:
+            os.dup2(fd, 1)
+            os.dup2(fd, 2)
+        finally:
+            if fd not in (1, 2):
+                os.close(fd)
+        faulthandler.disable()
+        if threading_main():
+            _signal_handler = lambda *_args: logging.getLogger("hermes.native").warning("[protected native log] signal diagnostics suppressed")
+            signal.signal(signal.SIGUSR2, _signal_handler)
+        _gateway_stdio_closed = True
+    except OSError:
+        raise SystemExit('Native log privacy console unavailable; startup refused.') from None
+
+
+def threading_main():
+    import threading
+    return threading.current_thread() is threading.main_thread()
+
+
+def _bootstrap():
+    global _privacy_factory
+    # This is a one-process startup marker; protocol children are not gateway hosts.
+    host_marker = os.environ.pop('HERMES_NATIVE_GATEWAY_HOST', None) == '1'
+    _load_policy()
+    if not _loaded:
+        return
+    previous = logging.getLogRecordFactory()
+
+    def factory(*args, **kwargs):
+        return protect_log_record(previous(*args, **kwargs))
+
+    _privacy_factory = factory
+    logging.setLogRecordFactory(factory)
+    argv = sys.argv
+    if host_marker or any(a == 'gateway' and b == 'run' for a, b in zip(argv, argv[1:])) or argv[0].replace('\\', '/').endswith('/gateway/run.py'):
+        suppress_gateway_stdio()
+
+
+_bootstrap()
